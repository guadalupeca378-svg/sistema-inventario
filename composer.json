{
    "name": "utcam/sistema-inventario",
    "description": "Sistema de Control de Inventario - Universidad Tecnológica de Campeche",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Inventario\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inventario\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always"
    },
    "config": {
        "sort-packages": true
    }
}
